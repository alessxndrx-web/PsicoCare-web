# PostgreSQL connection string. On Vercel, create the database from
# Storage > Create Database > Neon and this variable is injected automatically.
# For local development: docker run -d --name psicocare-pg -e POSTGRES_PASSWORD=psicocare \
#   -e POSTGRES_USER=psicocare -e POSTGRES_DB=psicocare -p 55432:5432 postgres:16-alpine
DATABASE_URL=

# Optional. Maximum pooled connections per server instance. Default 5.
DATABASE_POOL_MAX=

# The real public HTTPS origin. Required in production; no trailing path.
SITE_URL=http://localhost:3000

# Throwaway database used by `npm test`. Never point this at real data: the suite drops every table.
TEST_DATABASE_URL=

# Optional. Enables "Continuar con Google" on the survey. Leave both empty to hide that option
# and keep only the manual email field. Create them in Google Cloud > APIs & Services > Credentials
# (OAuth client, type "Web application") and register this exact redirect URI:
#   <SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Team access is per person: there is no shared password. Create the first account with
#   npm run team:bootstrap -- alguien@ejemplo.com "Nombre Apellido"
# and manage the rest from /admin/encuestas. BOOTSTRAP_PASSWORD is optional; if omitted,
# the command generates one and prints it once.
BOOTSTRAP_PASSWORD=
